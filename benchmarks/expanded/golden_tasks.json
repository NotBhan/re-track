        "application/processor.py",
        "domain/ports.py",
        "domain/document.py",
        "infrastructure/file_store.py"
      ],
      "critical_files": [
        "application/processor.py",
        "domain/ports.py"
      ],
      "expected_symbols": [
        "DocumentProcessor",
        "process_document",
        "DocumentStorePort",
        "DocumentParserPort",
        "Document",
        "DocumentStatus"
      ],
      "critical_symbols": [
        "DocumentProcessor",
        "process_document",
        "DocumentStorePort"
      ],
      "expected_relationships": [
        {
          "source": "application.processor.DocumentProcessor.process_document",
          "target": "domain.document.Document",
          "kind": "calls"
        }
